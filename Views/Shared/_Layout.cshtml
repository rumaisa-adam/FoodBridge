<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodBridge</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark custom-nav-container sticky-top shadow-sm" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-bold fs-4 text-white" asp-controller="Home" asp-action="Index">
                <img src="~/images/foodbridgelogo.jpg"
                     alt="FoodBridge Logo"
                     width="36"
                     height="36"
                     class="d-inline-block align-text-top me-2 rounded-circle" />
                <span>FoodBridge</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item custom-nav-item">
                        <a class="custom-nav-link @(ViewData["Title"]?.ToString() == "Listings" ? "active" : "")"
                           asp-controller="Surplus" asp-action="Listings">
                            <i class="bi bi-grid me-1"></i> Listings
                        </a>
                    </li>
                    <li class="nav-item custom-nav-item">
                        <a class="custom-nav-link @(ViewData["Title"]?.ToString() == "Post Surplus" ? "active" : "")"
                           asp-controller="Surplus" asp-action="Post">
                            <i class="bi bi-plus-circle me-1"></i> Post Surplus?
                        </a>
                    </li>
                    <li class="nav-item custom-nav-item ms-lg-2">
                        <a class="custom-nav-link @(ViewData["Title"]?.ToString() == "Fund a Meal" ? "active" : "")"
                           asp-controller="Donations" asp-action="Fund">
                            <i class="bi bi-gift-fill me-1"></i> Fund a Meal
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted">
        <div class="container">
            <span>&copy; 2026 FoodBridge &middot; University of Pretoria &middot; INF272 Assignment &middot; Student Number: <strong>u24787788</strong></span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>