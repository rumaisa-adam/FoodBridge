@model FoodBridge.Models.FoodItem
@{
    ViewData["Title"] = "Post Surplus";
}

<h2 class="fw-bold mb-4">Post Surplus</h2>

<div class="card shadow-sm border-0 p-4 rounded-4">
    <form asp-action="Post" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- User Information -->
        <h5 class="fw-bold text-warning border-bottom pb-2 mb-3">Your Details</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Full Name</label>
                @Html.DropDownList("PostedByUserId", (SelectList)ViewBag.Users, "-- Select User --", new { @class = "form-select", @id = "postUserDropdown", required = "required" })
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Phone Number (Read-only)</label>
                <input type="text" id="postUserPhone" class="form-control bg-light" readonly placeholder="Select a user above..." />
            </div>
        </div>

        <!-- Food Details -->
        <h5 class="fw-bold text-warning border-bottom pb-2 mb-3">Item Details</h5>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Item Name</label>
                <input asp-for="ItemName" class="form-control" placeholder="e.g. Sourdough Loaves" required />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Quantity</label>
                <input asp-for="Quantity" type="number" min="1" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Best-Before Date</label>
                <input asp-for="BestBeforeDate" type="date" class="form-control" required />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Category</label>
                @Html.DropDownList("CategoryId", (SelectList)ViewBag.Categories, "-- Select Category --", new { @class = "form-select", @id = "postCategoryDropdown", required = "required" })
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Item Type</label>
                <select name="ItemTypeId" id="postItemTypeDropdown" class="form-select" required>
                    <option value="">-- Select Category First --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Suburb</label>
                @Html.DropDownList("SuburbId", (SelectList)ViewBag.Suburbs, "-- Select Suburb --", new { @class = "form-select", required = "required" })
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold d-block">Storage Requirement</label>
            <div class="btn-group" role="group">
                @foreach (var storage in (List<FoodBridge.Models.Storage>)ViewBag.Storages)
                {
                    <input type="radio" class="btn-check" name="StorageId" id="storage_@storage.StorageID" value="@storage.StorageID" required />
                    <label class="btn btn-outline-secondary" for="storage_@storage.StorageID">@storage.Name</label>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Item Notes</label>
            <textarea asp-for="ItemNotes" class="form-control" rows="3" placeholder="Describe storage condition, allergens, pickup times..." required></textarea>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">Upload Image (&lt; 500KB)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" required />
        </div>

        <button type="submit" class="btn btn-warning btn-lg fw-bold px-5">Post</button>
    </form>
</div>

@section Scripts {
    <script>
        // Phone Number auto-fetch
        $('#postUserDropdown').change(function () {
            var userId = $(this).val();
            if (userId) {
                $.getJSON('/Surplus/GetUserPhoneNumber', { userId: userId }, function (data) {
                    $('#postUserPhone').val(data.phoneNumber);
                });
            } else {
                $('#postUserPhone').val('');
            }
        });

        // Cascading dropdown Category -> ItemType
        $('#postCategoryDropdown').change(function () {
            var catId = $(this).val();
            var $child = $('#postItemTypeDropdown');
            $child.empty().append('<option value="">-- Select Item Type --</option>');
            if (catId) {
                $.getJSON('/Surplus/GetItemTypesByCategory', { categoryId: catId }, function (data) {
                    $.each(data, function (i, item) {
                        $child.append($('<option/>', { value: item.itemTypeId, text: item.typeName }));
                    });
                });
            }
        });
    </script>
}