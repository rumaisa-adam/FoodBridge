@model IEnumerable<FoodBridge.Models.FoodItem>
@{
    ViewData["Title"] = "Listings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Surplus Food Listings</h2>
        <p class="text-muted small mb-0">Browse and claim available surplus food donations in Pretoria.</p>
    </div>
    <a asp-action="Post" class="btn btn-warning fw-bold text-dark shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Post Surplus?
    </a>
</div>

<!-- Filter Toolbar (Requirement 2.3) -->
<div class="card p-3 mb-4 shadow-sm border-0 bg-white rounded-3">
    <form method="get" asp-action="Listings" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Category</label>
            @Html.DropDownList("categoryID",
                        (ViewBag.Categories as SelectList) ?? new SelectList(Enumerable.Empty<SelectListItem>()),
                        "All Categories",
                        new { @class = "form-select", @id = "categoryDropdown" })
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Item Type</label>
            @Html.DropDownList("itemTypeID",
                        (ViewBag.ItemTypes as SelectList) ?? new SelectList(Enumerable.Empty<SelectListItem>()),
                        "Select Item Type",
                        new { @class = "form-select", @id = "itemTypeDropdown" })
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Suburb</label>
            @Html.DropDownList("suburbID",
                        (ViewBag.Suburbs as SelectList) ?? new SelectList(Enumerable.Empty<SelectListItem>()),
                        "All Suburbs",
                        new { @class = "form-select" })
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-warning flex-grow-1 fw-bold text-dark">
                <i class="bi bi-search me-1"></i> Search
            </button>
            <a asp-action="Listings" class="btn btn-outline-secondary fw-semibold">
                Clear
            </a>
        </div>
    </form>
</div>

<!-- Item Listings Grid with Box Model Styling -->
@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-5 shadow-sm rounded-3">
        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
        <h5 class="fw-bold">No surplus listings found</h5>
        <p class="text-muted small mb-0">Try clearing filters or check back later for new food donations.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 food-card">
                    <div class="card-img-container">
                        <img src="@item.ImageData"
                             class="food-card-img"
                             alt="@item.ItemName"
                             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1498837167922-ddd27525d352?w=600&auto=format&fit=crop&q=80';" />
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold text-dark mb-0">@item.ItemName</h5>
                            @if (item.Status == "Available")
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Claimed</span>
                            }
                        </div>

                        <p class="text-muted small mb-2">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(item.Suburb?.Name ?? "N/A")
                            &nbsp;|&nbsp;
                            <i class="bi bi-calendar3 me-1"></i>Best before: @item.BestBeforeDate.ToString("dd/MM/yyyy")
                        </p>

                        <div class="d-flex gap-2 mb-3">
                            <span class="badge bg-light text-dark border">Qty: @item.Quantity</span>
                            <span class="badge bg-light text-dark border">Storage: @(item.Storage?.Name ?? "Ambient")</span>
                        </div>

                        <p class="card-text text-secondary small flex-grow-1">
                            @(string.IsNullOrWhiteSpace(item.ItemNotes) ? "No notes provided." : item.ItemNotes)
                        </p>

                        <div class="pt-3 border-top mt-2">
                            <small class="text-muted d-block mb-2">
                                Posted by: <strong>@(item.PostedByUser != null ? (item.PostedByUser.FirstName + " " + item.PostedByUser.LastName) : "Community Member")</strong>
                            </small>

                            @if (item.Status == "Available")
                            {
                                <a asp-action="Claim" asp-route-id="@item.FoodItemId" class="btn btn-warning text-dark fw-bold w-100 shadow-sm">
                                    Claim This Item
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>
                                    Claimed
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        // Session 06 Cascading Dropdown via jQuery AJAX
        $(document).ready(function () {
            $('#categoryDropdown').change(function () {
                var selectedCategoryID = $(this).val();
                var $itemTypeDropdown = $('#itemTypeDropdown');
                $itemTypeDropdown.empty().append('<option value="">Select Item Type</option>');

                if (selectedCategoryID) {
                    $.getJSON('/Surplus/GetItemTypesByCategory', { categoryID: selectedCategoryID }, function (data) {
                        $.each(data, function (index, item) {
                            $itemTypeDropdown.append($('<option/>', {
                                value: item.itemTypeID,
                                text: item.name
                            }));
                        });
                    });
                }
            });
        });
    </script>
}