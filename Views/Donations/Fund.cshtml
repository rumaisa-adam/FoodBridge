@{
    ViewData["Title"] = "Fund a Meal";
    decimal totalRaised = ViewBag.TotalRaised ?? 0m;
    decimal targetGoal = ViewBag.TargetGoal ?? 20000m;
    int percentage = ViewBag.Percentage ?? 0;
    bool goalReached = ViewBag.GoalReached ?? false;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h2 class="fw-bold mb-3 text-dark">Fund a Meal Program</h2>
        <p class="text-secondary mb-4">Support our community kitchen by contributing towards our monthly food preparation goal.</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Progress Indicator Card (Requirement 2.6) -->
        <div class="card shadow-sm border-0 rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fs-5 fw-bold text-dark">
                    Raised: <span class="text-success">R@(totalRaised.ToString("N2"))</span>
                </span>
                <span class="text-muted fw-semibold">
                    Target: R@(targetGoal.ToString("N2"))
                </span>
            </div>

            <div class="progress" style="height: 26px; border-radius: 13px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated @(goalReached ? "bg-success" : "bg-warning text-dark") fw-bold fs-6"
                     role="progressbar"
                     style="width: @percentage%;"
                     aria-valuenow="@percentage"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    @percentage%
                </div>
            </div>

            <div class="mt-3">
                @if (goalReached)
                {
                    <div class="badge bg-success p-2 fs-6 fw-bold">
                        <i class="bi bi-trophy-fill me-1"></i> Goal Achieved! Thank you for your support!
                    </div>
                }
                else
                {
                    <span class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i> R@(((decimal)(targetGoal - totalRaised)).ToString("N2")) remaining to reach our goal.
                    </span>
                }
            </div>
        </div>

        <!-- Donation Form (Requirement 2.6) -->
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
            <h4 class="fw-bold mb-4 text-dark border-bottom pb-2">Make a Contribution</h4>
            <form asp-action="Fund" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Your Full Name</label>
                        @Html.DropDownList("userID",
                                                (ViewBag.Users as SelectList) ?? new SelectList(Enumerable.Empty<SelectListItem>()),
                                                "-- Select Your Name --",
                                                new { @class = "form-select", @id = "donationUserDropdown", required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone Number (Read-only)</label>
                        <input type="text" id="donationUserPhone" class="form-control bg-light" readonly placeholder="Select your name above..." />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Contribution Amount (ZAR)</label>
                    <div class="input-group">
                        <span class="input-group-text fw-bold">R</span>
                        <input type="number" name="amount" class="form-control form-control-lg" min="10" step="10" placeholder="e.g. 250" required />
                    </div>
                    <div class="form-text text-muted">Every R50 funds approximately 2 hot meals.</div>
                </div>

                <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark px-4 shadow-sm">
                        Complete Contribution
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Session 06 jQuery AJAX: Auto-fill read-only phone number
        $(document).ready(function () {
            $('#donationUserDropdown').change(function () {
                var selectedUserID = $(this).val();
                if (selectedUserID) {
                    $.getJSON('/Donations/GetUserPhoneNumber', { userID: selectedUserID }, function (data) {
                        $('#donationUserPhone').val(data.phoneNumber);
                    });
                } else {
                    $('#donationUserPhone').val('');
                }
            });
        });
    </script>
}