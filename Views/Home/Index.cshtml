@model IEnumerable<FoodBridge.Models.FoodItem>
@{
    ViewData["Title"] = "Home";
    int mealsShared = ViewBag.MealsShared ?? Model.Count();
}

<!-- Hero Welcome Section -->
<div class="p-5 mb-4 bg-white rounded-4 shadow-sm border border-light">
    <div class="container-fluid py-2">
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill mb-3">
            <i class="bi bi-geo-alt-fill me-1"></i> Hatfield & Pretoria Community Food Share
        </span>
        <h1 class="display-5 fw-bold text-dark mb-2">Connecting Surplus Food with Communities</h1>
        <p class="col-md-9 fs-5 text-muted mb-4">
            A student-led initiative to combat hunger and minimize local food waste. Browse freshly donated surplus items or donate to fund our community kitchen.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Surplus" asp-action="Listings" class="btn btn-warning btn-lg fw-bold text-dark px-4 shadow-sm">
                <i class="bi bi-search me-1"></i> View Available Surplus
            </a>
            <a asp-controller="Surplus" asp-action="Post" class="btn btn-outline-secondary btn-lg fw-semibold px-4">
                <i class="bi bi-box-seam me-1"></i> Post Surplus
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Requirement 2.2: Prominent Styled Impact Metric Card -->
    <div class="col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 text-white p-4 d-flex flex-column justify-content-between"
             style="background: linear-gradient(135deg, #2d6a4f 0%, #1b4332 100%);">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-uppercase tracking-wider small fw-bold text-white-50">Impact Counter</span>
                </div>
                <div class="display-2 fw-bolder mb-0 text-white" style="line-height: 1;">@mealsShared</div>
                <h3 class="fw-bold mt-2 mb-2 text-white">Meals Shared</h3>
                <p class="text-white-50 small mb-0">
                    Total surplus food packages rescued and claimed by local households to date.
                </p>
            </div>
            <div class="mt-4 pt-3 border-top border-white border-opacity-25 small text-white-50">
                <i class="bi bi-shield-check me-1 text-warning"></i> Verified Community Distribution
            </div>
        </div>
    </div>

    <!-- Requirement 2.2: Recent Community Claims Stream -->
    <div class="col-lg-8">
        <div class="card h-100 border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-activity text-success me-2"></i>Recent Community Claims
                </h5>
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                    Latest Activity
                </span>
            </div>

            <div class="card-body p-4 pt-2">
                @if (!Model.Any())
                {
                    <div class="alert alert-light text-center py-5 text-muted border-0">
                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <p class="mb-0">No claimed food items recorded yet.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model)
                        {
                            <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-warning-subtle text-warning d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                        <i class="bi bi-check2-circle fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@item.ItemName</h6>
                                        <small class="text-muted">
                                            Claimed by <strong class="text-dark">@(item.ClaimedByUser != null ? (item.ClaimedByUser.FirstName + " " + item.ClaimedByUser.LastName) : "Community Member")</strong>
                                        </small>
                                    </div>
                                </div>
                                <span class="badge bg-light text-secondary border">
                                    <i class="bi bi-clock-history me-1"></i>
                                    @(item.ClaimDate.HasValue? item.ClaimDate.Value.ToString("dd/MM/yyyy") : "Recently")
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>